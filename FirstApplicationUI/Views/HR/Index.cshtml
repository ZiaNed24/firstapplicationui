@model FirstApplicationUI.Models.HRDashboardViewModel
@{
    ViewData["Title"] = "HR Dashboard";
}
<style>
    .section-header {
        font-size: 20px;
        font-weight: 600;
        color: #2c3e50;
        border-left: 4px solid #1abc9c; /* Modern accent bar */
        background: #fff;
    }

        .section-header .badge {
            font-size: 14px;
            font-weight: 500;
        }

    .section-title {
        font-size: 22px;
        margin-top: 10px;
        font-weight: 600;
        color: #34495e;
    }

    .page-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        background: #fff;
        padding: 20px 25px;
        border-radius: 10px;
        box-shadow: 0 2px 8px rgba(0,0,0,0.08);
    }

    .main-title {
        margin: 0;
        font-size: 28px;
        font-weight: 700;
        color: #2c3e50;
    }

    .sub-title {
        margin: 5px 0 0;
        font-size: 16px;
        color: #7f8c8d;
    }

    .header-actions .badge {
        font-size: 15px;
        border-radius: 6px;
    }

    .dashboard-charts {
        display: flex;
        flex-wrap: wrap; /* responsive row wrap */
        gap: 20px;
        margin-top: 20px;
    }

    .chart-box {
        background: #fff;
        padding: 20px;
        border-radius: 10px;
        flex: 1 1 350px; /* responsive width */
        min-width: 300px; /* mobile safe */
        max-width: 100%; /* no overflow */
        height: auto;
        box-shadow: 0 0 8px rgba(0,0,0,0.1);
    }

        .chart-box canvas {
            width: 100% !important;
            height: 340px !important;
        }

    /* Make table responsive */
    #employeesTable {
        width: 100% !important;
        overflow-x: auto;
    }
</style>


<link rel="stylesheet" href="https://cdn.datatables.net/1.13.5/css/jquery.dataTables.min.css" />
<link rel="stylesheet" href="https://cdn.datatables.net/buttons/2.4.1/css/buttons.dataTables.min.css" />

<div class="page-header mb-4">
    <div>
        <h2 class="main-title">HR Dashboard</h2>
        <p class="sub-title">Welcome back, @Model.Username 👋</p>
    </div>

    <div class="header-actions">
        <span class="badge bg-primary px-3 py-2">
            Total Employees: @Model.Employees.Count()
        </span>
    </div>
</div>


<!-- Updated Employees List Section -->
<div class="section-header mb-3 p-3 rounded shadow-sm bg-white d-flex justify-content-between align-items-center">
    <h3 class="section-title m-0">Employees List</h3>
    <span class="badge bg-success px-3 py-2">
        Total: @Model.Employees.Count()
    </span>
</div>

<table id="employeesTable" class="display table table-bordered table-hover">
    <thead>
        <tr>
            <th>ID</th>
            <th>Name</th>
            <th>Email</th>
            <th>Job</th>
            <th>Department</th>
            <th>EmploymentStatus</th>
            <th>Manager</th>
            <th>Salary</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var emp in Model.Employees)
        {
            <tr>
                <td>@emp.EmployeeId</td>
                <td>@(string.Join(" ", emp.FirstName, emp.LastName))</td>
                <td>@emp.Email</td>
                <td>@(string.IsNullOrWhiteSpace(emp.JobTitle) ? "N/A" : emp.JobTitle)</td>
                <td>@(string.IsNullOrWhiteSpace(emp.DepartmentName) ? "N/A" : emp.DepartmentName)</td>
                <td>
                    @{
                        string badgeClass = emp.EmploymentStatus switch
                        {
                            "Probation" => "badge bg-warning text-dark",  // Yellow
                            "Permanent" => "badge bg-success",            // Green
                            "Notice Period" => "badge bg-primary",        // Blue
                            "Terminated" => "badge bg-danger",            // Red
                            "Resigned" => "badge bg-secondary",           // Gray
                            _ => "badge bg-dark"                          // Default
                        };
                    }

                    <span class="@badgeClass">
                        @emp.EmploymentStatus
                    </span>
                </td>
                <td>@(string.IsNullOrWhiteSpace(emp.ManagerName) ? "N/A" : emp.ManagerName)</td>
                <td>@(emp.Salary.HasValue? emp.Salary.Value.ToString("N0") : "0")</td>
                <td>
                    <a class="btn btn-sm btn-info mb-1" href="/Employee/Details/@emp.EmployeeId">View</a>
                </td>
            </tr>
        }
    </tbody>
</table>

<hr />

<div class="dashboard-charts">

    <div class="chart-box">
        <h5 class="text-center mb-3">Employees per Department</h5>
        <canvas id="deptChart"></canvas>
    </div>

    <div class="chart-box">
        <h5 class="text-center mb-3">Salary Distribution</h5>
        <canvas id="salaryChart"></canvas>
    </div>

</div>


<script src="https://code.jquery.com/jquery-3.7.0.min.js"></script>
<script src="https://cdn.datatables.net/1.13.5/js/jquery.dataTables.min.js"></script>
<script src="https://cdn.datatables.net/buttons/2.4.1/js/dataTables.buttons.min.js"></script>
<script src="https://cdn.datatables.net/buttons/2.4.1/js/buttons.html5.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/jszip/3.10.1/jszip.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/pdfmake/0.2.7/pdfmake.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/pdfmake/0.2.7/vfs_fonts.js"></script>
<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

<script>
    // ---------------- DATA TABLE ----------------
    $(document).ready(function () {
        $('#employeesTable').DataTable({
            dom: 'Bfrtip',
            buttons: ['excelHtml5', 'pdfHtml5','csvHtml5']
        });
    });

    // ---------------- FETCH MODEL DATA ----------------
    const employees = @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(Model.Employees));

    // ---------------- EMPLOYEES PER DEPARTMENT BAR CHART ----------------
        // Employees per Department (Corrected)
    const deptCounts = {};
    employees.forEach(e => {
        const dept = e.DepartmentName || "N/A";
        deptCounts[dept] = (deptCounts[dept] || 0) + 1;
    });


    const deptLabels = Object.keys(deptCounts);
    const deptData = Object.values(deptCounts);

    const ctxDept = document.getElementById('deptChart').getContext('2d');

    new Chart(ctxDept, {
        type: 'bar',
        data: {
            labels: deptLabels,
            datasets: [{
                label: 'Employees per Department',
                data: deptData,
                backgroundColor: [
                    'rgba(255, 99, 132, 0.2)',
                    'rgba(255, 159, 64, 0.2)',
                    'rgba(255, 205, 86, 0.2)',
                    'rgba(75, 192, 192, 0.2)',
                    'rgba(54, 162, 235, 0.2)',
                    'rgba(153, 102, 255, 0.2)',
                    'rgba(201, 203, 207, 0.2)'
                ],
                borderColor: [
                    'rgb(255, 99, 132)',
                    'rgb(255, 159, 64)',
                    'rgb(255, 205, 86)',
                    'rgb(75, 192, 192)',
                    'rgb(54, 162, 235)',
                    'rgb(153, 102, 255)',
                    'rgb(201, 203, 207)'
                ],
                borderWidth: 1
            }]
        },
        options: {
            responsive: true,
            scales: {
                y: { beginAtZero: true }
            }
        }
    });

    // ---------------- SALARY PIE CHART ----------------
        // Salary Distribution
    const salaryLabels = employees.map(e => (e.FirstName || "") + " " + (e.LastName || ""));
    const salaryData = employees.map(e => e.Salary || 0);

    const randomColors = salaryData.map(_ =>
        `hsl(${Math.random() * 360}, 70%, 60%)`
    );

    const ctxSalary = document.getElementById('salaryChart').getContext('2d');

    new Chart(ctxSalary, {
        type: 'pie',
        data: {
            labels: salaryLabels,
            datasets: [{
                data: salaryData,
                backgroundColor: randomColors
            }]
        },
        options: { responsive: true }
    });

</script>
