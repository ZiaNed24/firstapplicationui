<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Admin Panel</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />

    <style>
        body {
            overflow-x: hidden;
            font-family: 'Segoe UI', sans-serif;
            background: #f0f2f5;
        }

        /* Sidebar */
        #sidebar-lg {
            width: 240px;
            height: 100vh;
            background: #1e1e2f;
            color: white;
            padding-top: 20px;
            position: fixed;
            top: 0;
            left: 0;
        }

            #sidebar-lg a {
                color: #fff;
                padding: 12px 20px;
                text-decoration: none;
                display: block;
                border-radius: 8px;
                margin: 4px 8px;
                transition: all 0.3s ease;
            }

                #sidebar-lg a:hover {
                    background: #343454;
                    box-shadow: 2px 2px 8px rgba(0,0,0,0.2);
                }

        /* Content */
        .content-wrapper {
            margin-left: 240px;
            padding: 20px;
        }

        /* Navbar */
        .navbar {
            background: #1e1e2f;
            color: white;
        }

            .navbar .navbar-brand, .navbar .nav-link {
                color: white;
            }

        /* Card / Table Shadow (polymorphism style) */
        .card, table {
            border-radius: 12px;
            box-shadow: 5px 5px 15px rgba(0,0,0,0.1);
            background: #ffffff;
        }

        /* Responsive */
        @@media (max-width: 991px) {
            .content-wrapper

        {
            margin-left: 0;
        }

        #sidebar-lg {
            display: none;
        }

        }
    </style>
</head>
<body>

    <!-- Sidebar -->
    <div id="sidebar-lg" class="d-none d-lg-block">
        <h4 class="text-center mb-4">Admin Panel</h4>
        <a href="/Home/Index">Dashboard</a>
        <a href="/Users/Index">Users</a>
        <a href="/Product/Index">Products</a>
        <a href="/Orders/Index">Orders</a>
        <a href="/Settings/Index">Settings</a>
    </div>

    <!-- Top Navbar -->
    <nav class="navbar navbar-expand-lg navbar-dark position-sticky top-0 z-3" style="background:#1e1e2f">
        <div class="container-fluid">
            <button class="btn btn-outline-light d-lg-none me-2" data-bs-toggle="offcanvas" data-bs-target="#mobileSidebar">
                ☰
            </button>

            <a class="navbar-brand" href="/">Admin Panel</a>

            <div class="collapse navbar-collapse" id="navbarNav">
                <ul class="navbar-nav ms-auto align-items-center">
                    <li class="nav-item me-3">
                        <span class="text-light">Hello, @Context.Session.GetString("Username")</span>
                    </li>
                    <li class="nav-item dropdown">
                        <a class="nav-link dropdown-toggle" data-bs-toggle="dropdown" href="#">Profile</a>
                        <ul class="dropdown-menu dropdown-menu-end">
                            <li><a class="dropdown-item" href="#">My Account</a></li>
                            <li><a class="dropdown-item" href="#">Settings</a></li>
                            <li><hr class="dropdown-divider" /></li>
                            <li><a class="dropdown-item" href="@Url.Action("Logout", "Account")">Logout</a></li>
                        </ul>
                    </li>
                </ul>
            </div>
        </div>
    </nav>


    <div class="content-wrapper">
        @RenderBody()
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
</body>
</html>
