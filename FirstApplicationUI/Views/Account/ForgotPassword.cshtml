@model ForgotPasswordVm
@{
    Layout = "~/Views/Shared/_AuthLayout.cshtml";
    ViewData["Title"] = "Forgot Password";
}

<div class="container mt-5" style="max-width:700px;">
    <div class="card shadow">
        <div class="row g-0">
            <!-- LEFT: Image -->
            <div class="col-md-5 d-none d-md-block">
                <img src="~/images/architecture-2256489.jpg" class="img-fluid h-100 w-100" style="object-fit: cover; border-radius: 6px 0 0 6px;" />
            </div>

            <!-- RIGHT: Form -->
            <div class="col-md-7 p-4">
                <h3 class="text-center mb-4">Forgot Password</h3>

                <form asp-action="ForgotPassword" method="post">
                    <div class="mb-3">
                        <label class="form-label">Email</label>
                        <input asp-for="Email" class="form-control" placeholder="Enter your email" />
                        <span asp-validation-for="Email" class="text-danger"></span>
                    </div>

                    <button type="submit" class="btn btn-primary w-100 mt-3">Send Reset Link</button>

                    @if (!ViewData.ModelState.IsValid)
                    {
                        <div class="text-danger mt-2">
                            @ViewData.ModelState[string.Empty]?.Errors.FirstOrDefault()?.ErrorMessage
                        </div>
                    }

                    @if (ViewBag.Message != null)
                    {
                        <div class="text-success mt-2">@ViewBag.Message</div>
                    }

                    <div class="text-center mt-3">
                        <a asp-action="Login" asp-controller="Account">Back to Login</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
